#[module(retrovert)]

const RV_PLAYBACK_PLUGIN_API_VERSION = 2

extern opaque RVService

enum ProbeResult {
    Supported = 0,
    Unsupported = 1,
    Unsure = 2,
}

enum ReadStatus {
    DecodingRequest = 0,
    Ok = 1,
    Finished = 2,
    Error = 3,
}

enum SettingsUpdate {
    Default = 0,
    RequireRestart = 1,
}

#[attributes(bitflags)]
enum VizCaps {
    PatternCells = 1,
    Scope = 2,
    Vu = 4,
    WholeSongKnown = 8,
    SeekablePreview = 16,
    FutureKnown = 32,
}

enum ScrollMode {
    Synchronized = 0,
    PerChannel = 1,
}

enum ColumnKind {
    Note = 0,
    Instrument = 1,
    Volume = 2,
    Effect = 3,
    Param = 4,
    Custom = 5,
}

#[attributes(Copy)]
struct ReadInfo {
    format: AudioFormat,
    frame_count: u32,
    status: ReadStatus,
}

#[attributes(Copy)]
struct ReadData {
    channels_output: *void,
    channels_output_max_bytes_size: u32,
    info: ReadInfo,
}

#[attributes(Copy)]
struct VizStructure {
    caps: u32,
    scroll_mode: ScrollMode,
    pattern_channel_count: u32,
    scope_channel_count: u32,
    column_count: u32,
}

#[attributes(Copy)]
struct ColumnDesc {
    label: [u8; 16],
    char_width: u8,
    kind: ColumnKind,
}

#[attributes(Copy)]
struct ChannelDesc {
    name: [u8; 24],
    scope_width: u8,
}

#[attributes(Copy)]
struct VizPosition {
    order: u32,
    pattern: u32,
    row: u32,
    window_lo: u32,
    window_hi: u32,
}

#[attributes(Copy)]
struct Cell {
    raw: u32,
    text: [u8; 16],
}

struct PlaybackPlugin {
    api_version: u64,
    name: *const char,
    version: *const char,
    library_version: *const char,
    probe_can_play(data: *u8, data_size: u64, filename: *const char, total_size: u64) -> ProbeResult,
    supported_extensions() -> *const char,
    create(services: *const RVService) -> *void,
    destroy(user_data: *void) -> i32,
    event(user_data: *void, data: *u8, data_size: u64),
    open(user_data: *void, url: *const char, subsong: u32, services: *const RVService) -> i32,
    close(user_data: *void),
    read_data(user_data: *void, dest: ReadData) -> ReadInfo,
    seek(user_data: *void, ms: i64) -> i64,
    metadata(url: *const char, services: *const RVService) -> i32,
    static_init(services: *const RVService),
    settings_updated(user_data: *void, services: *const RVService) -> SettingsUpdate,
    static_destroy(),

    get_structure(user_data: *void, out: *VizStructure) -> bool,
    get_columns(user_data: *void, out: *ColumnDesc, cap: u32) -> u32,
    get_pattern_channels(user_data: *void, out: *ChannelDesc, cap: u32) -> u32,
    get_scope_channels(user_data: *void, out: *ChannelDesc, cap: u32) -> u32,
    get_position(user_data: *void, out: *VizPosition) -> bool,
    get_channel_rows(user_data: *void, out: *u32, cap: u32) -> u32,
    get_cells(user_data: *void, channel: i32, row_lo: u32, row_hi: u32, out: *Cell, cap: u32) -> u32,
    set_scope_enabled(user_data: *void, on: bool),
    get_scope_samples(user_data: *void, channel: i32, out: *f32, cap: u32) -> u32,
    get_vu(user_data: *void, out: *f32, cap: u32) -> u32,
}
